    <string name="shortcut_daily_short">Daily</string>
    <string name="shortcut_daily_long">Daily challenge</string>
    <string name="shortcut_report_bug_short">Report a bug</string>
    <string name="shortcut_report_bug_long">Report a bug</string>
</resources>
