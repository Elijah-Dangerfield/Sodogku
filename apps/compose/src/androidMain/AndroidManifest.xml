<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
    allowBackup is off, and that is a decision rather than an oversight. Settings
    tells the player in as many words that progress does not survive a reinstall
    or a move to a new phone, because there are no accounts. Auto Backup would
    have made that copy false *sometimes*, which is the worst of both — a restore
    that may or may not happen is not something a player can plan around. It
    would also have carried the install id to a second device, which is the one
    thing that identifier is supposed to never do.
    -->
    <application
        android:name=".SodogkuApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sodogku">
        <activity
            android:exported="true"
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|uiMode|keyboardHidden|smallestScreenSize|density|fontScale|locale">
            <!--
              configChanges: handle these changes inside Compose instead of
              letting Android recreate the Activity. Without this, the
              FloatingWindowNavigator instance passed to rememberNavController
              changes on recreation, which causes nav-compose to discard its
              saved back stack and pop the user to the start destination.
              All listed config changes are reactive in Compose (orientation,
              font scale, dark mode, density, locale), so the Activity does
              not need to recreate for them.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Custom-scheme deep links. Consumers:
              - `sodogku://auth/confirmed` — Supabase verify-email redirect.
              - `sodogku://login-callback` — browser OAuth return trip;
                NOT a nav route. MainActivity forwards it to the DeepLinkBridge
                so supabase-kt can capture the session (see App.kt).
              Per-route mapping happens via the `deepLinks` parameter on
              `screen<Route>` in the relevant FeatureEntryPoint; Compose
              NavHost reads `Activity.intent.data` automatically when a
              filter here matches.

              When adding App Links (https://, requires assetlinks.json on
              the host) sit them alongside this filter as a separate
              <intent-filter android:autoVerify="true"> block.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sodogku" />
            </intent-filter>
        </activity>

        <!--
          AdMob reads this before any Kotlin runs, so it cannot live in
          `AdUnits.kt` with the ad unit ids. The value below is Google's
          published *sample* app id, which pairs with the sample ad units in
          `AdUnits.AndroidTest`. Replace it with the real one from the AdMob
          console at the same time as `AdUnits.useTestUnits` flips — the SDK
          crashes the app at startup if this key is missing entirely, and
          silently serves nothing if it names an app the ad units do not
          belong to.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>