            "uid": "grafanacloud-logs"
          },
          "editorMode": "code",
          "expr": "count(count by (install_id) (count_over_time({service_name=\"sodogku-client\", deployment_environment=\"$env\"} | event_name=\"game.level_started\" | mode=\"campaign\" [$__range])))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "title": "Installs playing the campaign",
      "type": "stat"
    },
