<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <string name="streak_title">Streak</string>

    <!-- The circular button. `label` is what it is, `days` / `none` is what it says. -->
    <string name="streak_indicator_label">Streak</string>
    <string name="streak_indicator_days">%1$d day streak</string>
    <string name="streak_indicator_none">No streak yet</string>

    <string name="streak_current_days">%1$d day streak</string>
    <string name="streak_current_none">No streak yet</string>
    <string name="streak_longest">Longest run: %1$d days</string>
    <string name="streak_longest_none">No run to beat yet</string>
    <string name="streak_calendar_title">The last five weeks</string>
    <string name="streak_empty_body">Play the daily puzzle and this fills in. Miss a day and it starts again.</string>

    <!-- One per day cell. Spoken, not printed: the grid itself shows a colour. -->
    <string name="streak_day_completed">Played</string>
    <string name="streak_day_bridged">Covered</string>
    <string name="streak_day_failed">Out of bones</string>
    <string name="streak_day_missed">Missed</string>
    <string name="streak_day_future">Not yet</string>
    <string name="streak_day_today">%1$s, today</string>

    <string name="streak_weekday_mon">M</string>
    <string name="streak_weekday_tue">T</string>
    <string name="streak_weekday_wed">W</string>
    <string name="streak_weekday_thu">T</string>
    <string name="streak_weekday_fri">F</string>
    <string name="streak_weekday_sat">S</string>
    <string name="streak_weekday_sun">S</string>

    <string name="streak_off_title">The daily is not running</string>
    <string name="streak_off_body">Streaks come from the daily puzzle. Nothing you have already played is lost.</string>

    <string name="streak_celebrate_title">%1$d days in a row</string>
    <string name="streak_celebrate_body">Same time tomorrow.</string>
    <string name="streak_celebrate_done">Nice</string>

    <!-- The question above the number, which is the number's answer. Asked
         rather than asserted, because a page that opens by telling somebody
         they are committed has decided for them. -->
    <string name="streak_intention_title">Can you keep this up?</string>
    <!-- Under the streak. Names the stake in the only terms this game has: the
         dog. Deliberately not a mechanic explanation; the player can see the
         week filling in above it, and a paragraph about how streaks work would
         be teaching something the picture already taught. -->
    <string name="streak_intention_body">Every day you keep it going is another good day for this dog.</string>
    <!-- One button, and it is an agreement rather than an instruction. "I'm
         game" over "I'm committed" because this is a puzzle about dogs and the
         contract register belongs to a language app. -->
    <string name="streak_intention_cta">I'm game</string>

    <!-- Under the big number. A plural because "1 days" is the kind of thing a
         player notices on the one screen that is congratulating them. -->
    <plurals name="streak_day_label">
        <item quantity="one">day streak</item>
        <item quantity="other">day streak</item>
    </plurals>
    <!-- Only shown when there is a run to lose and today has not kept it yet.
         Names the action rather than the clock: the hours are there to make it
         feel possible, not to start a timer. -->
    <string name="streak_keep_it_today">Finish any board in the next %1$s to keep your streak.</string>
</resources>
