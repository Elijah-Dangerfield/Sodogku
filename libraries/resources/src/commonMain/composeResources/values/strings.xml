    <!-- Tutorial (SPEC 10). One title + body per TutorialStep; the exhaustive
         `when` in TutorialCoachMark is what keeps this list honest. -->
    <string name="tutorial_got_it">Got it</string>
    <string name="tutorial_skip">Skip tutorial</string>
    <string name="tutorial_rule_region_title">One dog per color</string>
    <string name="tutorial_rule_region_body">Every colored block holds exactly one dog. Never two, never none.</string>
    <string name="tutorial_rule_line_title">One per row and column</string>
    <string name="tutorial_rule_line_body">The same across the grid. Each row gets one dog, and so does each column.</string>
    <string name="tutorial_rule_touching_title">Dogs keep their distance</string>
    <string name="tutorial_rule_touching_body">No two dogs may sit next to each other. Corners count as next to.</string>
    <string name="tutorial_starter_dog_title">Here is one for free</string>
    <string name="tutorial_starter_dog_body">The early levels start you off. Every square this one rules out is crossed off already.</string>
    <string name="tutorial_mark_square_title">Cross a square off</string>
    <string name="tutorial_mark_square_body">One tap marks a square as empty. It costs nothing, so mark freely. Try the lit square.</string>
    <string name="tutorial_place_dog_title">Two taps places a dog</string>
    <string name="tutorial_place_dog_body">Tap the lit square twice, quickly. A dog belongs here.</string>
    <string name="tutorial_bones_title">Three bones an attempt</string>
    <string name="tutorial_bones_body">Putting a dog on the wrong square costs one. Crossing squares off never does. Now finish the board.</string>
    <string name="tutorial_place_and_watch_title">Place this one</string>
    <string name="tutorial_place_and_watch_body">Two quick taps on the lit square, then watch what the board does.</string>
    <string name="tutorial_auto_mark_title">The board marks for you</string>
    <string name="tutorial_auto_mark_body">Every square that dog rules out was crossed off for you. On the bigger grids this is most of the work.</string>
    <string name="tutorial_sniff_title">Sniff</string>
    <string name="tutorial_sniff_body">Stuck? A sniff rules a few squares out. It never says where a dog goes, so the puzzle stays yours.</string>
    <string name="tutorial_treat_title">Treat</string>
    <string name="tutorial_treat_body">A treat places one dog correctly, with no bone at risk. Now finish this board.</string>
    <string name="tutorial_no_touching_title">Nothing sits beside a dog</string>
    <string name="tutorial_no_touching_body">A dog rules out every square it touches, corners included. That is the ring around this one.</string>
    <string name="tutorial_try_wrong_title">Get one wrong on purpose</string>
    <string name="tutorial_try_wrong_body">Two taps on the lit square. No dog lives there, and this one mistake is on us.</string>
    <string name="tutorial_wrong_explained_title">That is a wrong guess</string>
    <string name="tutorial_wrong_explained_body">Red means no dog, and it normally costs a bone. Yours are all still here.</string>
    <string name="tutorial_graduation_title">You know how to play</string>
    <string name="tutorial_graduation_body">Finish this board and the other 497 are yours. The three rules stay at the top if you ever want them.</string>

    <string name="settings_rerun_tutorial">Replay the tutorial</string>
