    <!-- Board accessibility (SPEC 16). Every one of these is spoken, never
         drawn, so they are written to be *heard* — short, and in the order a
         player needs them: where the square is, which colour it belongs to,
         and what is on it. The region names double as the vocabulary a player
         uses talking to a sighted friend, so they are colour words rather than
         region numbers. In colourblind mode the glyph names replace them,
         because the glyph is what is on the square. -->
    <string name="board_cell_format">Row %1$d, column %2$d, %3$s</string>
    <string name="board_cell_empty">empty</string>
    <string name="board_cell_marked">crossed off</string>
    <string name="board_cell_proposed">suggested, not yet kept</string>

    <!-- The sniff proposes rather than reveals. It paints faint crosses and waits
         for one tap to keep them, so the hint lands on the board instead of in
         the player's memory. -->
    <string name="hint_apply">Cross them off</string>
    <string name="hint_discard">Leave them</string>

